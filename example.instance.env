# Instance settings, loaded on top of .env when running:
#   ./start_battlefront.sh --instance example
# Copy this file to <id>.instance.env (e.g. prequel.instance.env) and run with --instance <id>.
# Any .env setting can be overridden here. Plugins are shared between all instances,
# so set KYBER_ENABLED_PLUGINS in .env rather than here.

KYBER_SERVER_NAME="Conquest - Prequel Era - 24/7"
#KYBER_SERVER_MODES="conquest"
KYBER_SERVER_ERAS="prequel"

# Stagger restarts between instances
#KYBER_RESTART_SCHEDULE="5 4 * * *"
